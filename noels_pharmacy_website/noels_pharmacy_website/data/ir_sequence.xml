<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_noels_prescription_request" model="ir.sequence">
        <field name="name">Online Prescription Request</field>
        <field name="code">noels.prescription.request</field>
        <field name="prefix">NPR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_noels_contact_request" model="ir.sequence">
        <field name="name">Website Contact Request</field>
        <field name="code">noels.contact.request</field>
        <field name="prefix">NCR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

