<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="noels_product_card" name="Noel's Product Card">
        <article class="noels-product-card">
            <a t-att-href="product.website_url" class="noels-product-card__image">
                <span class="noels-product-card__badge" t-if="product.noels_brand_id" t-out="product.noels_brand_id.name"/>
                <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                     t-att-alt="product.name" loading="lazy"/>
            </a>
            <div class="noels-product-card__body">
                <small t-if="product.public_categ_ids" t-out="product.public_categ_ids[0].name"/>
                <h3><a t-att-href="product.website_url" t-out="product.name"/></h3>
                <div class="noels-product-card__footer">
                    <strong><span t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/></strong>
                    <form t-if="product.product_variant_count == 1" action="/shop/cart/update" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>
                        <input type="hidden" name="add_qty" value="1"/>
                        <button type="submit" aria-label="Add to cart"><i class="fa fa-shopping-bag"/></button>
                    </form>
                    <a t-else="" t-att-href="product.website_url" class="noels-product-options" aria-label="Choose product options"><i class="fa fa-arrow-right"/></a>
                </div>
            </div>
        </article>
    </template>

    <template id="noels_homepage" inherit_id="website.homepage" name="Noel's Pharmacy Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure noels-home">
                <t t-set="product_domain" t-value="[('is_published', '=', True), ('sale_ok', '=', True), '|', ('website_id', '=', False), ('website_id', '=', request.website.id)]"/>
                <t t-set="featured_products" t-value="request.env['product.template'].sudo().search(product_domain, order='website_sequence asc, id desc', limit=8)"/>
                <t t-set="new_products" t-value="request.env['product.template'].sudo().search(product_domain, order='create_date desc, id desc', limit=4)"/>
                <t t-set="public_categories" t-value="request.env['product.public.category'].sudo().search([], order='sequence asc, name asc', limit=6)"/>
                <t t-set="published_brands" t-value="request.env['noels.brand'].sudo().search([('is_published', '=', True), '|', ('website_id', '=', False), ('website_id', '=', request.website.id)], limit=8)"/>

                <section class="noels-hero">
                    <div class="container-xl noels-hero__grid">
                        <div class="noels-hero__content">
                            <span class="noels-eyebrow"><i class="fa fa-plus"/> A new standard in neighbourhood care</span>
                            <h1>Wellness feels better when care feels <em>personal.</em></h1>
                            <p>Trusted pharmacy essentials, thoughtful support and convenient online shopping—now closer to home in Endeavour, Chaguanas.</p>
                            <div class="noels-hero__actions">
                                <a href="/shop" class="btn noels-btn noels-btn--primary">Shop health &amp; wellness <i class="fa fa-arrow-right"/></a>
                                <a href="/prescriptions" class="btn noels-btn noels-btn--ghost"><i class="fa fa-file-text-o"/> Send a prescription</a>
                            </div>
                            <div class="noels-hero__proof">
                                <div><b>100%</b><span>Authentic products</span></div>
                                <div><b>Odoo</b><span>Secure checkout</span></div>
                                <div><b>Local</b><span>Care in Chaguanas</span></div>
                            </div>
                        </div>
                        <div class="noels-hero__visual">
                            <div class="noels-hero__orb noels-hero__orb--one"/>
                            <div class="noels-hero__orb noels-hero__orb--two"/>
                            <div class="noels-hero__card">
                                <div class="noels-hero__card-head">
                                    <span>Everyday wellness</span>
                                    <i class="fa fa-heartbeat"/>
                                </div>
                                <div t-if="featured_products" class="noels-hero__products">
                                    <a t-foreach="featured_products[:3]" t-as="hero_product" t-att-href="hero_product.website_url" class="noels-hero__product">
                                        <img t-att-src="'/web/image/product.template/%s/image_512' % hero_product.id" t-att-alt="hero_product.name"/>
                                    </a>
                                </div>
                                <div t-else="" class="noels-hero__fallback">
                                    <span class="noels-bottle noels-bottle--one"/>
                                    <span class="noels-bottle noels-bottle--two"/>
                                    <span class="noels-box"/>
                                </div>
                                <div class="noels-hero__card-note"><i class="fa fa-check-circle"/> Products appear here automatically when published in Odoo</div>
                            </div>
                            <div class="noels-hero__mini noels-hero__mini--rx"><i class="fa fa-file-text-o"/><span><b>Prescription?</b>Upload securely</span></div>
                            <div class="noels-hero__mini noels-hero__mini--care"><i class="fa fa-user-md"/><span><b>Need help?</b>Talk with our team</span></div>
                        </div>
                    </div>
                </section>

                <section class="noels-trustbar">
                    <div class="container-xl noels-trustbar__grid">
                        <div><i class="fa fa-shield"/><span><b>Genuine products</b>Carefully sourced</span></div>
                        <div><i class="fa fa-lock"/><span><b>Secure payments</b>Odoo protected checkout</span></div>
                        <div><i class="fa fa-truck"/><span><b>Convenient fulfilment</b>Pickup or available delivery</span></div>
                        <div><i class="fa fa-comments-o"/><span><b>Real support</b>Call or WhatsApp Noel's</span></div>
                    </div>
                </section>

                <section class="noels-section noels-service-intro">
                    <div class="container-xl">
                        <div class="noels-section-heading noels-section-heading--split">
                            <div><span class="noels-eyebrow">Care made simple</span><h2>Three easy ways Noel's helps.</h2></div>
                            <p>Shop everyday essentials, submit prescriptions securely and get help from a local team that puts clarity first.</p>
                        </div>
                        <div class="noels-feature-grid">
                            <a href="/prescriptions" class="noels-feature-card noels-feature-card--blue">
                                <span class="noels-feature-card__icon"><i class="fa fa-file-text-o"/></span>
                                <div><small>01 / Prescriptions</small><h3>Send it securely. We take it from there.</h3><p>Upload clear prescription images or PDFs for pharmacist review and choose pickup or delivery.</p><b>Start a request <i class="fa fa-arrow-right"/></b></div>
                            </a>
                            <a href="/shop" class="noels-feature-card noels-feature-card--green">
                                <span class="noels-feature-card__icon"><i class="fa fa-shopping-bag"/></span>
                                <div><small>02 / Shop online</small><h3>Your everyday wellness, in one place.</h3><p>Browse published Odoo products with live pricing, variants, inventory and secure checkout.</p><b>Explore the shop <i class="fa fa-arrow-right"/></b></div>
                            </a>
                            <a href="/pharmacy-services" class="noels-feature-card noels-feature-card--cream">
                                <span class="noels-feature-card__icon"><i class="fa fa-heartbeat"/></span>
                                <div><small>03 / Pharmacy care</small><h3>Guidance that feels human.</h3><p>Ask questions, understand your options and receive practical support from the Noel's team.</p><b>View services <i class="fa fa-arrow-right"/></b></div>
                            </a>
                        </div>
                    </div>
                </section>

                <section class="noels-section noels-categories">
                    <div class="container-xl">
                        <div class="noels-section-heading noels-section-heading--split">
                            <div><span class="noels-eyebrow">Find what you need</span><h2>Shop by category.</h2></div>
                            <a href="/shop">View all products <i class="fa fa-arrow-right"/></a>
                        </div>
                        <div t-if="public_categories" class="noels-category-grid">
                            <a t-foreach="public_categories" t-as="category" t-att-href="'/shop/category/%s' % slug(category)" class="noels-category-card">
                                <div class="noels-category-card__image">
                                    <img t-att-src="'/web/image/product.public.category/%s/image_1920' % category.id" t-att-alt="category.name" loading="lazy"/>
                                </div>
                                <div><h3 t-out="category.name"/><span>Explore <i class="fa fa-arrow-right"/></span></div>
                            </a>
                        </div>
                        <div t-else="" class="noels-category-grid noels-category-grid--fallback">
                            <a href="/shop?search=vitamins" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-leaf"/></div><div><h3>Vitamins &amp; supplements</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                            <a href="/shop?search=personal+care" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-tint"/></div><div><h3>Personal care</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                            <a href="/shop?search=baby" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-smile-o"/></div><div><h3>Baby &amp; child</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                            <a href="/shop?search=first+aid" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-medkit"/></div><div><h3>First aid</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                            <a href="/shop?search=medical+devices" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-stethoscope"/></div><div><h3>Medical devices</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                            <a href="/shop?search=wellness" class="noels-category-card"><div class="noels-category-icon"><i class="fa fa-heartbeat"/></div><div><h3>Everyday wellness</h3><span>Explore <i class="fa fa-arrow-right"/></span></div></a>
                        </div>
                    </div>
                </section>

                <section class="noels-section noels-products-section">
                    <div class="container-xl">
                        <div class="noels-section-heading noels-section-heading--split">
                            <div><span class="noels-eyebrow">From our shelves</span><h2>Featured products.</h2></div>
                            <a href="/shop">Shop the full range <i class="fa fa-arrow-right"/></a>
                        </div>
                        <div t-if="featured_products" class="noels-product-grid">
                            <t t-foreach="featured_products" t-as="product"><t t-call="noels_pharmacy_website.noels_product_card"/></t>
                        </div>
                        <div t-else="" class="noels-empty-products">
                            <i class="fa fa-cubes"/><h3>Your published products will appear here.</h3><p>Publish products in Odoo Website / eCommerce and the homepage updates automatically.</p>
                        </div>
                    </div>
                </section>

                <section class="noels-section noels-promo-section">
                    <div class="container-xl noels-promo-grid">
                        <div class="noels-promo noels-promo--main">
                            <span class="noels-eyebrow noels-eyebrow--light">Everyday wellness</span>
                            <h2>Small routines.<br/>Better days.</h2>
                            <p>Explore essentials that help you care for yourself and your family, one day at a time.</p>
                            <a href="/wellness" class="btn noels-btn noels-btn--white">Explore wellness <i class="fa fa-arrow-right"/></a>
                            <div class="noels-promo__art"><i class="fa fa-leaf"/><i class="fa fa-heartbeat"/><i class="fa fa-plus"/></div>
                        </div>
                        <div class="noels-promo noels-promo--rx">
                            <span class="noels-eyebrow">Prescription support</span>
                            <h2>Skip the extra trip.</h2>
                            <p>Send your prescription online and let our team review it before you come in.</p>
                            <a href="/prescriptions">Upload securely <i class="fa fa-arrow-right"/></a>
                            <div class="noels-rx-art"><i class="fa fa-file-text-o"/><span>Rx</span></div>
                        </div>
                    </div>
                </section>

                <section t-if="new_products" class="noels-section noels-products-section noels-products-section--new">
                    <div class="container-xl">
                        <div class="noels-section-heading noels-section-heading--split"><div><span class="noels-eyebrow">Just added</span><h2>New arrivals.</h2></div><a href="/shop">See everything <i class="fa fa-arrow-right"/></a></div>
                        <div class="noels-product-grid noels-product-grid--four">
                            <t t-foreach="new_products" t-as="product"><t t-call="noels_pharmacy_website.noels_product_card"/></t>
                        </div>
                    </div>
                </section>

                <section class="noels-section noels-prescription-steps">
                    <div class="container-xl noels-prescription-steps__panel">
                        <div class="noels-section-heading"><span class="noels-eyebrow noels-eyebrow--light">Prescription made easy</span><h2>From upload to ready—with clarity at every step.</h2></div>
                        <div class="noels-steps-grid">
                            <div><b>1</b><h3>Upload</h3><p>Send a clear image or PDF using the secure request form.</p></div>
                            <div><b>2</b><h3>Pharmacist review</h3><p>Our team checks the prescription and confirms the next steps.</p></div>
                            <div><b>3</b><h3>Confirm</h3><p>We contact you about availability, pricing and fulfilment.</p></div>
                            <div><b>4</b><h3>Collect or receive</h3><p>Choose store pickup or available delivery when submitting.</p></div>
                        </div>
                        <a href="/prescriptions" class="btn noels-btn noels-btn--white">Start prescription request</a>
                    </div>
                </section>

                <section t-if="published_brands" class="noels-section noels-brands-strip">
                    <div class="container-xl">
                        <div class="noels-section-heading noels-section-heading--center"><span class="noels-eyebrow">Trusted names</span><h2>Brands available at Noel's.</h2></div>
                        <div class="noels-brand-grid">
                            <a t-foreach="published_brands" t-as="brand" t-att-href="brand.website_url" class="noels-brand-logo">
                                <img t-if="brand.image_1920" t-att-src="'/web/image/noels.brand/%s/image_1920' % brand.id" t-att-alt="brand.name"/>
                                <span t-else="" t-out="brand.name"/>
                            </a>
                        </div>
                    </div>
                </section>

                <section class="noels-section noels-local-section">
                    <div class="container-xl noels-local-grid">
                        <div class="noels-local-art"><span class="noels-local-art__cross">+</span><div><i class="fa fa-map-marker"/><b>Endeavour</b><small>Chaguanas</small></div></div>
                        <div><span class="noels-eyebrow">Meet your new local pharmacy</span><h2>Modern convenience.<br/>Neighbourhood warmth.</h2><p>Noel's Pharmacy &amp; Wellness Center Ltd. is being built around a simple belief: good care should feel accessible, respectful and easy to understand.</p><div class="noels-local-actions"><a href="/about-us" class="btn noels-btn noels-btn--primary">Discover Noel's</a><a href="https://maps.google.com/?q=55+Rodney+Road+Endeavour+Chaguanas" target="_blank" rel="noopener">Get directions <i class="fa fa-arrow-right"/></a></div></div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
