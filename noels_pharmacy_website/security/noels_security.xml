<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_noels_online_user" model="res.groups">
        <field name="name">Noel's Online User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_noels_online_manager" model="res.groups">
        <field name="name">Noel's Online Manager</field>
        <field name="implied_ids" eval="[(4, ref('noels_pharmacy_website.group_noels_online_user'))]"/>
    </record>

    <record id="rule_prescription_company" model="ir.rule">
        <field name="name">Prescription requests by company</field>
        <field name="model_id" ref="model_noels_prescription_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('noels_pharmacy_website.group_noels_online_user'))]"/>
    </record>

    <record id="rule_contact_company" model="ir.rule">
        <field name="name">Contact requests by company</field>
        <field name="model_id" ref="model_noels_contact_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('noels_pharmacy_website.group_noels_online_user'))]"/>
    </record>
</odoo>

