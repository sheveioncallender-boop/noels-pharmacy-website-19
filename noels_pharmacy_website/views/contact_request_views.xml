<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_noels_contact_request_list" model="ir.ui.view">
        <field name="name">noels.contact.request.list</field>
        <field name="model">noels.contact.request</field>
        <field name="arch" type="xml">
            <list string="Website Enquiries" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="email" optional="show"/>
                <field name="subject"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_noels_contact_request_form" model="ir.ui.view">
        <field name="name">noels.contact.request.form</field>
        <field name="model">noels.contact.request</field>
        <field name="arch" type="xml">
            <form string="Website Enquiry">
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_done" type="object" string="Resolve" class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="create_date" readonly="1"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_noels_contact_requests" model="ir.actions.act_window">
        <field name="name">Website Enquiries</field>
        <field name="res_model">noels.contact.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No website enquiries yet</p>
        </field>
    </record>
</odoo>

