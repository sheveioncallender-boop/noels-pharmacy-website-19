<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="noels_footer" name="Noel’s footer">
    <div class="noels-content noels-footer">
      <div class="wrap footer-main">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/noels_pharmacy_website/static/src/img/noels-logo.webp" width="1274" height="451" alt="Noel’s Pharmacy &amp; Wellness Center Ltd" class="img-fluid"/>
          </div>
          <p>A little care can make a big difference.<br/>Your wellbeing is at the heart of it.</p>
        </div>
        <div>
          <h2>Explore</h2>
          <a href="/">Home</a>
          <a href="/shop">Shop all products</a><a href="/pharmacy-services">Our services</a>
          <a href="/wellness">Wellness</a>
        <a href="/my/orders">My orders</a></div>
        <div>
          <h2>Get to know us</h2>
          <a href="/about-noels">About Noel’s</a>
          <a href="/visit-noels">Visit &amp; contact</a>
          <a href="/pharmacy-services#questions">Common questions</a>
        </div>
        <div class="footer-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>
          </svg>
          <p>Here for your health.<br/>Here for you.</p>
          <span>NOEL’S PHARMACY<br/>&amp; WELLNESS CENTER LTD</span>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© 2026 Noel’s Pharmacy &amp; Wellness Center Ltd.</span>
        <span>Website by <a href="https://spxcorp.net" target="_blank" rel="noopener">Spxcorp Limited</a></span>
      </div>
    </div>
  </template>
  <template id="layout_brand" inherit_id="website.layout" priority="99" name="Noel’s branding around native Odoo layout">
    <xpath expr="//div[@id='wrapwrap']" position="attributes">
      <attribute name="t-attf-class" add="#{'noels-site' if website.noels_brand_enabled else ''}" separator=" "/>
    </xpath>
    <xpath expr="//footer[@id='bottom']" position="inside">
      <t t-if="website.noels_brand_enabled and not no_footer" t-call="noels_pharmacy_website.noels_footer"/>
    </xpath>
    <xpath expr="//div[@id='wrapwrap']/main" position="before">
      <div t-if="website.noels_brand_enabled and website.noels_catalogue_notice" class="noels-catalogue-notice" role="note">Sample catalogue — products and prices are for website testing.</div>
    </xpath>
  <xpath expr="//header/*[1]" position="before"><t t-call="noels_pharmacy_website.noels_announcement"/></xpath></template>
<template id="noels_phone_link" name="Noel’s company phone">
    <a t-if="website.company_id.phone" t-att-href="'tel:' + website.company_id.phone" class="noels-phone-link">
      <i class="fa fa-phone" aria-hidden="true"/><span class="o_force_ltr" t-field="website.company_id.phone"/>
    </a>
    <a t-else="" href="/visit-noels" class="noels-phone-link">Visit &amp; contact</a>
  </template>
  <template id="noels_announcement" name="Noel’s announcement strip">
    <div t-if="website.noels_brand_enabled" class="noels-topbar">
      <div class="noels-topbar-inner">
        <span>Your neighbourhood pharmacy <strong>— Care for every day.</strong></span>
        <div class="noels-topbar-contact"><span t-if="website.noels_opening_hours" t-field="website.noels_opening_hours"/><t t-call="noels_pharmacy_website.noels_phone_link"/></div>
      </div>
    </div>
  </template>
  <template id="noels_header_order" inherit_id="website_sale.template_header_default" priority="60" name="Noel’s native header order">
    <xpath expr="//t[@t-call='website.placeholder_header_text_element']" position="attributes"><attribute name="t-if">not website.noels_brand_enabled</attribute></xpath>
    <xpath expr="//t[@t-call='website.placeholder_header_call_to_action']" position="attributes"><attribute name="t-if">not website.noels_brand_enabled</attribute></xpath>
    <xpath expr="//t[@t-call='portal.user_dropdown']" position="attributes">
      <attribute name="_user_name">not website.noels_brand_enabled</attribute>
      <attribute name="_icon">website.noels_brand_enabled</attribute>
      <attribute name="_link_class.f"/>
      <attribute name="_link_class">'o_navlink_background btn rounded-circle position-relative text-reset' if website.noels_brand_enabled else ((_additional_btn_color or 'nav-link') + ' border-0')</attribute>
    </xpath>
    <xpath expr="//t[@t-call='website_sale.header_cart_link']" position="attributes"><attribute name="t-if">not website.noels_brand_enabled</attribute></xpath>
    <xpath expr="//t[@t-call='portal.user_dropdown']" position="after">
      <t t-if="website.noels_brand_enabled" t-call="website_sale.header_cart_link" _icon="True" _text="False" _item_class.f="o_no_autohide_item" _link_class.f="o_navlink_background btn rounded-circle position-relative text-reset" _badge_class.f="position-absolute top-0 end-0"/>
    </xpath>
  </template>
  <template id="noels_account_label" inherit_id="portal.user_dropdown" name="Account button accessibility">
    <xpath expr="//a[@data-bs-toggle='dropdown']" position="attributes"><attribute name="aria-label">My account</attribute></xpath>
  </template>
<template id="noels_native_phone" inherit_id="website.header_text_element" priority="60" name="Noel’s native phone element"><xpath expr="(//a[starts-with(@href, 'tel:')])[3]" position="replace"><t t-if="website.noels_brand_enabled" t-call="noels_pharmacy_website.noels_phone_link"/><a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary p-2" t-else="">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small>+1 555-555-5556</small></span>
                    </a>
                </xpath><xpath expr="(//a[starts-with(@href, 'tel:')])[2]" position="replace"><t t-if="website.noels_brand_enabled" t-call="noels_pharmacy_website.noels_phone_link"/><a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset" t-else="">
                        <i class="fa fa-1x fa-fw fa-phone me-1"/>
                        <span class="o_force_ltr"><small>+1 555-555-5556</small></span>
                    </a>
                </xpath><xpath expr="(//a[starts-with(@href, 'tel:')])[1]" position="replace"><t t-if="website.noels_brand_enabled" t-call="noels_pharmacy_website.noels_phone_link"/><a href="tel:+1 555-555-5556" class="nav-link o_nav-link_secondary" t-else="">
                        <small>
                            <i class="fa fa-1x fa-fw fa-phone me-1"/>͏ <!-- Empty character needed to be able to delete the icon. -->
                            <span class="o_force_ltr">+1 555-555-5556</span>
                        </small>
                    </a>
                    </xpath></template></odoo>
