<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="noels_shop_styling" inherit_id="website_sale.products" name="Noel's Shop Styling">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="noels-shop-page" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='o_wsale_container']" position="before">
            <section class="noels-shop-banner">
                <div class="container-xl">
                    <div>
                        <span class="noels-eyebrow noels-eyebrow--light">Noel's online pharmacy</span>
                        <h1 t-if="category" t-out="category.name"/>
                        <h1 t-elif="search">Search results</h1>
                        <h1 t-else="">Health, wellness &amp; everyday care.</h1>
                        <p>Live products, prices and availability—managed directly in Odoo.</p>
                    </div>
                    <a href="/prescriptions"><i class="fa fa-file-text-o"/><span><b>Have a prescription?</b>Send it securely <i class="fa fa-arrow-right"/></span></a>
                </div>
            </section>
        </xpath>
    </template>

    <template id="noels_product_styling" inherit_id="website_sale.product" name="Noel's Product Styling">
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="noels-product-page" separator=" "/>
        </xpath>
    </template>
</odoo>

